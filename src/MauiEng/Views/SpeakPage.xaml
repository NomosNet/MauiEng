<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiEng.Views.SpeakPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiEng.ViewModels"
    xmlns:core="clr-namespace:MauiEng.Core;assembly=MauiEng.Core"
    x:DataType="vm:SpeakViewModel"
    Title="Проговаривание"
    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid Padding="24,24,24,28" RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Spacing="8">
            <Label Text="Фразы за последние дни" FontAttributes="Bold" FontSize="24" />
            <Label
                Text="Нажмите «Сказать», чтобы произнести вслух."
                FontSize="15"
                TextColor="{StaticResource Gray500}" />
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{StaticResource Danger}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label
                Text="Пока нет фраз — добавьте их после сериала."
                IsVisible="{Binding IsEmpty}"
                FontSize="16" />
        </VerticalStackLayout>

        <CollectionView
            x:Name="PhraseList"
            Grid.Row="1"
            ItemsSource="{Binding Phrases}"
            Margin="0,12,0,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:PhraseItem">
                    <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Text}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Translation}" FontSize="14" TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                Text="Сказать"
                                Command="{Binding Source={x:Reference PhraseList}, Path=BindingContext.SpeakCommand}"
                                CommandParameter="{Binding .}"
                                HeightRequest="44"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="2"
            Text="Готово"
            Command="{Binding CompleteCommand}"
            HeightRequest="64"
            FontSize="20" />
    </Grid>
</ContentPage>
