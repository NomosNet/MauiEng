<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiEng.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiEng.ViewModels"
    x:DataType="vm:TodayViewModel"
    Title="Сегодня"
    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Grid Padding="24,32,24,28" RowDefinitions="*,Auto">
        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
            <Label
                Text="Серия"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource Gray500}" />
            <Label
                Text="{Binding Streak}"
                FontAttributes="Bold"
                FontSize="88"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding StreakCaption}"
                FontSize="18"
                HorizontalTextAlignment="Center" />

            <BoxView
                HeightRequest="1"
                Margin="0,28,0,20"
                Color="{StaticResource Gray200}" />

            <Label
                Text="Цель на сегодня"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource Gray500}" />
            <Label
                Text="{Binding GoalText}"
                FontAttributes="Bold"
                FontSize="32"
                HorizontalTextAlignment="Center" />
            <ProgressBar
                HeightRequest="8"
                Margin="0,8,0,0"
                Progress="{Binding GoalProgress}"
                ProgressColor="{StaticResource Primary}" />
            <Label
                Text="{Binding DueText}"
                Margin="0,16,0,0"
                FontSize="16"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{StaticResource Danger}"
                HorizontalTextAlignment="Center" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>

        <Button
            Grid.Row="1"
            Text="Заниматься"
            Command="{Binding StartCommand}"
            HeightRequest="64"
            FontSize="20" />
    </Grid>
</ContentPage>
