<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiEng.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiEng.ViewModels"
    x:DataType="vm:TodayViewModel"
    Title="Сегодня"
    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,28" Spacing="14">
            <Label
                Text="🔥"
                FontSize="42"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding Streak}"
                FontAttributes="Bold"
                FontSize="72"
                HorizontalTextAlignment="Center" />
            <Label
                Text="{Binding StreakCaption}"
                FontSize="18"
                HorizontalTextAlignment="Center" />

            <Label
                Margin="0,12,0,0"
                Text="План на сегодня"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="{StaticResource Gray500}" />
            <Label
                Text="{Binding GoalText}"
                FontAttributes="Bold"
                FontSize="28"
                HorizontalTextAlignment="Center" />
            <ProgressBar
                HeightRequest="8"
                Progress="{Binding GoalProgress}"
                ProgressColor="{StaticResource Primary}" />

            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{StaticResource Danger}"
                HorizontalTextAlignment="Center" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding CardsText}" FontSize="17" FontAttributes="Bold" />
                    <Button Text="Заниматься" Command="{Binding StartCardsCommand}" HeightRequest="52" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ReadingText}" FontSize="17" FontAttributes="Bold" />
                    <Label Text="{Binding BookName}" FontSize="14" TextColor="{StaticResource Gray500}" />
                    <Button Text="Выбрать книгу" Command="{Binding PickBookCommand}" HeightRequest="48" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Открыть" Command="{Binding OpenReadingCommand}" HeightRequest="48" />
                        <Button Grid.Column="1" Text="Готово" Command="{Binding CompleteReadingCommand}" HeightRequest="48" />
                    </Grid>
                    <Button Text="Добавить слово" Command="{Binding AddWordCommand}" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding WatchingText}" FontSize="17" FontAttributes="Bold" />
                    <Label Text="{Binding VideoName}" FontSize="14" TextColor="{StaticResource Gray500}" />
                    <Button Text="Выбрать видео" Command="{Binding PickVideoCommand}" HeightRequest="48" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Открыть" Command="{Binding OpenWatchingCommand}" HeightRequest="48" />
                        <Button Grid.Column="1" Text="Готово" Command="{Binding CompleteWatchingCommand}" HeightRequest="48" />
                    </Grid>
                    <Button Text="Добавить фразу" Command="{Binding AddPhraseCommand}" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SpeakingText}" FontSize="17" FontAttributes="Bold" />
                    <Button Text="Проговаривать" Command="{Binding StartSpeakingCommand}" HeightRequest="52" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
